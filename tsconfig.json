{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ps/shared": ["packages/shared/src/index.ts"],
      "@ps/engine": ["packages/engine/src/index.ts"],
      "@ps/ai-gm": ["packages/ai-gm/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "scripts"]
}
